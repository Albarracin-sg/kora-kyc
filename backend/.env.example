PORT=3000
NODE_ENV=development
POSTGRES_DB=kora_kyc
POSTGRES_USER=kora
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://kora:kora_local_password@localhost:5432/kora_kyc?schema=public
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:8081
LOCAL_STORAGE_ROOT=./upload
KYC_ASSETS_ROOT=./assets
KYC_ASSET_MANIFEST_PATH=./assets/manifest.json
TESSERACT_LANG_DIRECTORY=tesseract
HUMAN_MODELS_DIRECTORY=human-models
KYC_DOCUMENT_HASH_PEPPER=replace-with-a-separate-random-secret
# Document extraction. Gemini remains the default selected provider.
KYC_DOCUMENT_PROVIDER=gemini
GEMINI_API_KEY=replace-with-a-backend-only-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Set these only when explicitly selecting KYC_DOCUMENT_PROVIDER=huggingface.
# The model must include a concrete provider suffix; do not use :fastest, :cheapest, or :preferred.
HUGGINGFACE_API_TOKEN=replace-with-a-backend-only-hugging-face-token
HUGGINGFACE_DOCUMENT_MODEL=Qwen/Qwen2.5-VL-72B-Instruct:ovhcloud
HUGGINGFACE_DOCUMENT_TIMEOUT_MS=30000
KYC_IMAGE_MAX_BYTES=10485760
KYC_IMAGE_MAX_PIXELS=12000000
KYC_IMAGE_MAX_DIMENSION=2048
KYC_OCR_WORKERS=2
KYC_OCR_MIN_CONFIDENCE=0.65
KYC_JOB_LOCK_TIMEOUT_MS=60000
KYC_FACE_MIN_SIMILARITY=0.72
KYC_FACE_MAX_DISTANCE=0.85
KYC_FACE_MIN_CONFIDENCE=0.65
# Face verification. `local` (Human/TFJS on the backend) remains the default selected provider.
# `face_service` selects the standalone FastAPI face-service over HTTP. Both providers are
# explicit selections only — never a fallback. Set these only when choosing face_service.
FACE_VERIFICATION_PROVIDER=local
FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_TIMEOUT_MS=30000
# HTTP security layer (helmet + @nestjs/throttler)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_TTL_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_TTL_MS=60000
RATE_LIMIT_AUTH_BLOCK_MS=300000
RATE_LIMIT_KYC_LIMIT=30
RATE_LIMIT_KYC_TTL_MS=60000
RATE_LIMIT_KYC_BLOCK_MS=120000
